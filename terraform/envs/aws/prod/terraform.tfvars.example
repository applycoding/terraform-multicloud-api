environment             = "prod"
region                  = "us-east-1"
vpc_cidr                = "10.30.0.0/16"
availability_zones      = ["us-east-1a", "us-east-1b"]
single_nat_gateway      = false
desired_count           = 2
task_cpu                = 512
task_memory             = 1024
database_instance_class = "db.t4g.small"

# Replace every value below. The account ID and certificate are placeholders.
certificate_arn             = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"
container_image             = "123456789012.dkr.ecr.us-east-1.amazonaws.com/portfolio-api:0.1.0"
rotation_lambda_arn         = "arn:aws:lambda:us-east-1:123456789012:function:portfolio-prod-secret-rotation"
alb_logs_bucket_name        = "replace-me-portfolio-prod-alb-logs"
alb_logs_access_bucket_name = "replace-me-portfolio-prod-alb-access"
